# Copy to .env. Leave GROQ_API_KEY empty to run with no chat model.
# Facts and refusals do not need a key. Do not commit .env.
#
# Blank GROQ_MODEL uses llama-3.3-70b-versatile.
# Blank GROQ_BASE_URL uses https://api.groq.com/openai/v1.
# Blank DATABASE_PATH uses data/assistant.db.
# Blank EMBEDDING_MODEL uses sentence-transformers/all-MiniLM-L6-v2.

GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=
DATABASE_PATH=
EMBEDDING_MODEL=
